# Application
APP_NAME=conversational-bi
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Platform database
DATABASE_URL=postgresql+asyncpg://bi_user:bi_password@localhost:5432/conversational_bi

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-32-byte-key-for-fernet!!
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# LLM
LLM_PROVIDER=google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=conversational-bi

# Query limits
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=10000

# Rate limiting
RATE_LIMIT_PER_USER=60
RATE_LIMIT_PER_ORG=1000

# Internationalization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fr,de,es,hi,zh

# OIDC (optional)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
